{
  "name": "payment-gateway-system",
  "version": "1.0.0",
  "description": "Payment Gateway Management System",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "dev:server": "cd server && node app.js",
    "dev:client": "cd client && npm start",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/app.js"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  }
}
